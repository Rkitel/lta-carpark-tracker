# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LTA_DATAMALL_ACCOUNT_KEY: API key for Singapore Land Transport Authority (LTA) DataMall.
# Register for a free key at: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_DATAMALL_ACCOUNT_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"

# ONEMAP API Credentials (Singapore Land Authority - SLA):
# Register free at: https://www.onemap.gov.sg/apidocs/
# Tokens are automatically minted and cached via POST /api/auth/post/getToken (lasts 3 days)
ONEMAP_EMAIL="YOUR_ONEMAP_EMAIL"
ONEMAP_PASSWORD="YOUR_ONEMAP_PASSWORD"
# Optional direct token override:
ONEMAP_API_TOKEN="YOUR_ONEMAP_API_TOKEN"
